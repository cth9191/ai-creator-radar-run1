{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devcorner.schema.json",
  "title": "devcorner",
  "type": "object",
  "properties": {
    "sample": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tag",
          "published_at",
          "url"
        ]
      }
    },
    "news": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "source": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "title",
          "url"
        ]
      }
    }
  },
  "required": [
    "generated_at",
    "releases"
  ]
}
