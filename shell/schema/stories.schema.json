{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stories.schema.json",
  "title": "stories",
  "type": "object",
  "properties": {
    "sample": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "x_grabbed_at": {
      "type": "string",
      "format": "date-time"
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_query": {
            "type": "string"
          },
          "first_seen": {
            "type": "string",
            "format": "date-time"
          },
          "post_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "post_count": {
            "type": "integer",
            "minimum": 0
          },
          "engagement": {
            "type": "integer",
            "minimum": 0
          },
          "velocity": {
            "type": "number"
          },
          "top_posts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "author": {
                  "type": "object",
                  "properties": {
                    "handle": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "followers": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "verified": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "handle"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "likes": {
                  "type": "integer",
                  "minimum": 0
                },
                "reposts": {
                  "type": "integer",
                  "minimum": 0
                },
                "replies": {
                  "type": "integer",
                  "minimum": 0
                },
                "quotes": {
                  "type": "integer",
                  "minimum": 0
                },
                "views": {
                  "type": "integer",
                  "minimum": 0
                },
                "query": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "url",
                "author",
                "text",
                "created_at",
                "likes",
                "reposts"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "search_query",
          "first_seen",
          "post_count",
          "engagement"
        ]
      }
    }
  },
  "required": [
    "generated_at",
    "stories"
  ]
}
