{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta.schema.json",
  "title": "meta",
  "type": "object",
  "properties": {
    "sample": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "x_status": {
      "enum": [
        "fresh",
        "waiting_for_pc"
      ]
    },
    "x_grabbed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "next_refresh_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "updated_at",
    "x_status",
    "x_grabbed_at"
  ]
}
