{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runlog.schema.json",
  "title": "runlog",
  "type": "object",
  "properties": {
    "sample": {
      "type": "boolean"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "fail"
            ]
          },
          "chips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                }
              },
              "required": [
                "label",
                "ok"
              ]
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "at",
          "status",
          "chips"
        ]
      }
    }
  },
  "required": [
    "runs"
  ]
}
