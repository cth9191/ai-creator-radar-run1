{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "x.schema.json",
  "title": "x",
  "type": "object",
  "properties": {
    "sample": {
      "type": "boolean"
    },
    "grabbed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "pc",
        "sample"
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "author": {
            "type": "object",
            "properties": {
              "handle": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "followers": {
                "type": "integer",
                "minimum": 0
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": [
              "handle"
            ]
          },
          "text": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "likes": {
            "type": "integer",
            "minimum": 0
          },
          "reposts": {
            "type": "integer",
            "minimum": 0
          },
          "replies": {
            "type": "integer",
            "minimum": 0
          },
          "quotes": {
            "type": "integer",
            "minimum": 0
          },
          "views": {
            "type": "integer",
            "minimum": 0
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "author",
          "text",
          "created_at",
          "likes",
          "reposts"
        ]
      }
    }
  },
  "required": [
    "grabbed_at",
    "posts"
  ]
}
